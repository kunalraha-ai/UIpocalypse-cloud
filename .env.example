# --- UIpocalypse Cloud local dev (never commit real secrets) ---
DATABASE_URL=postgres://uipoc:uipoc@localhost:5435/uipocalypse_cloud
APP_URL=http://localhost:4311

# session signing — generate with: openssl rand -hex 32
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef

# OAuth (create apps at github.com/settings/developers and console.cloud.google.com;
# callback URLs: {APP_URL}/api/auth/github/callback and /api/auth/google/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker
WORKER_CONCURRENCY=2
