{
  "name": "uipocalypse-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "UIpocalypse Cloud — hosted website monitoring and testing: finds what breaks for visitors, honestly.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 4311",
    "build": "next build",
    "start": "next start -p 4311",
    "worker": "node --env-file=.env --watch false --experimental-strip-types worker/worker.ts",
    "migrate": "node --env-file=.env --experimental-strip-types scripts/migrate.ts up",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^15.1.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
